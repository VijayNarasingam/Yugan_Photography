<%- include('../partials/head') %>

<main class="login">
  <section class="login__media" aria-hidden="true">
    <%- picture(content.home.hero.image, {
      priority: true,
      sizes: '50vw',
      class: 'login__img',
      decorative: true
    }) %>
    <div class="login__media-shade"></div>
    <div class="login__media-copy">
      <p class="eyebrow">Private studio</p>
      <p class="login__quote">“<%= content.home.quote.text %>”</p>
      <p class="login__credit"><%= content.home.quote.attribution %></p>
    </div>
  </section>

  <section class="login__panel">
    <div class="login__inner">
      <a class="brand brand--login" href="/" aria-label="<%= site.name %> — return to site">
        <span class="brand__name"><%= site.name %></span>
        <span class="brand__role">Photography</span>
      </a>

      <div class="login__head">
        <p class="eyebrow">Studio access</p>
        <h1 class="display login__title">Welcome back.</h1>
        <p class="login__intro">Sign in to manage photographs, projects, and enquiries. This area is private and not indexed.</p>
      </div>

      <% if (loginError) { %>
        <div class="alert alert--error" role="alert">
          <span class="alert__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'alert' }) %></span>
          <p><%= loginError %></p>
        </div>
      <% } %>

      <form class="login-form" method="post" action="/admin/login" data-login-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">

        <div class="field">
          <label class="field__label" for="login-username">Username</label>
          <input class="field__input" type="text" id="login-username" name="username" value="<%= username %>" autocomplete="username" required autofocus>
        </div>

        <div class="field">
          <label class="field__label" for="login-password">Password</label>
          <div class="password-wrap">
            <input class="field__input" type="password" id="login-password" name="password" autocomplete="current-password" required>
            <button class="password-toggle" type="button" data-password-toggle aria-label="Show password" aria-pressed="false">
              <span data-password-show><%- include('../partials/icon', { name: 'eye' }) %></span>
              <span data-password-hide hidden><%- include('../partials/icon', { name: 'eyeOff' }) %></span>
            </button>
          </div>
        </div>

        <button class="button button--ink button--full" type="submit">Enter the studio <%- include('../partials/icon', { name: 'arrow' }) %></button>
      </form>

      <div class="login__foot">
        <p><%- include('../partials/icon', { name: 'lock' }) %> Single-administrator access. Sessions expire after seven days.</p>
        <a class="link-arrow" href="/"><span>Return to the site</span><%- include('../partials/icon', { name: 'arrowLeft' }) %></a>
      </div>
    </div>
  </section>
</main>

<script src="/js/login.js" defer></script>
</body>
</html>
