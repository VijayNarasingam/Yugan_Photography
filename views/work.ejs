<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <header class="page-head page-head--work shell">
    <div class="page-head__top">
      <p class="eyebrow">Selected work <span class="page-head__count">(<%= projects.length %>)</span></p>
      <p class="page-head__index">01 <span aria-hidden="true">/</span> 04</p>
    </div>
    <h1 class="display page-head__title">Projects,<br><em>in their own time.</em></h1>
    <div class="page-head__foot">
      <p class="page-head__lead">A selection of Indian weddings photographed with natural light and quiet emotion — ceremonies, celebrations, and the quiet moments in between.</p>
      <div class="page-head__meta">
        <p><span>Disciplines</span>Wedding, portrait, celebration</p>
        <p><span>Territory</span>India &amp; beyond</p>
      </div>
    </div>
  </header>

  <section class="work-index shell" aria-labelledby="work-index-title">
    <h2 class="visually-hidden" id="work-index-title">Project index</h2>

    <div class="filter-bar" data-filter-bar>
      <div class="filter-bar__group" role="group" aria-label="Filter projects by category">
        <button class="filter" type="button" data-filter="all" aria-pressed="true">All <span><%= projects.length %></span></button>
        <% categories.forEach(function (category) { %>
          <button class="filter" type="button" data-filter="<%= category %>" aria-pressed="false">
            <%= category %> <span><%= projects.filter(function (p) { return p.category === category; }).length %></span>
          </button>
        <% }); %>
      </div>
      <p class="filter-bar__result" data-filter-result aria-live="polite"><%= projects.length %> projects</p>
    </div>

    <div class="work-grid" data-work-grid>
      <% projects.forEach(function (project, i) { %>
        <%- include('partials/project-card', {
          project: project,
          index: String(i + 1).padStart(2, '0'),
          variant: i % 3 === 0 ? 'lead' : (i % 3 === 1 ? 'offset' : 'low'),
          sizes: '(min-width: 900px) 46vw, 100vw'
        }) %>
      <% }); %>
    </div>

    <div class="empty-state" data-filter-empty hidden>
      <p class="eyebrow">Nothing here yet</p>
      <h3 class="display">No projects in this category.</h3>
      <p>Try another discipline, or view the full index.</p>
      <button class="button button--outline" type="button" data-filter-reset>View all work</button>
    </div>
  </section>

  <% if (mosaicPhotos && mosaicPhotos.length > 1) { %>
    <section class="work-mosaic" aria-labelledby="work-mosaic-title">
      <div class="shell">
        <div class="work-mosaic__head">
          <p class="eyebrow">The wider archive</p>
          <p class="work-mosaic__count"><%= mosaicPhotos.length %> frames</p>
        </div>

        <div class="work-mosaic__grid">
          <div class="work-mosaic__intro">
            <%- picture(mosaicPhotos[0], {
              class: 'work-mosaic__intro-img',
              decorative: true,
              sizes: '(min-width: 900px) 50vw, 100vw'
            }) %>
            <span class="work-mosaic__intro-shade" aria-hidden="true"></span>
            <div class="work-mosaic__intro-content">
              <h2 class="display work-mosaic__title" id="work-mosaic-title">Between<br>the rituals,<br><em>the quiet.</em></h2>
              <p class="work-mosaic__body">The glance before the vows. The laughter after the ceremony. The small, unscripted moments that hold a wedding together.</p>
              <a class="button work-mosaic__cta" href="/contact">
                <span>Start a conversation</span>
                <%- include('partials/icon', { name: 'arrow' }) %>
              </a>
            </div>
          </div>

          <% mosaicPhotos.slice(1).forEach(function (photo, i) { %>
            <a class="work-mosaic__item work-mosaic__item--<%= i + 1 %>" href="/work/<%= photo.projectSlug %>" aria-label="View <%= photo.galleryTitle %> — <%= photo.caption || 'photograph' %>">
              <%- picture(photo, {
                class: 'work-mosaic__img',
                sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 50vw, 100vw'
              }) %>
              <span class="work-mosaic__caption"><%= photo.caption || photo.galleryTitle %></span>
              <span class="work-mosaic__arrow" aria-hidden="true"><%- include('partials/icon', { name: 'arrowUpRight' }) %></span>
            </a>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <%- include('partials/cta') %>
</main>

<%- include('partials/footer') %>
