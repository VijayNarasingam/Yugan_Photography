<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <header class="page-head shell">
    <div class="page-head__top">
      <p class="eyebrow"><%= content.about.kicker %></p>
      <p class="page-head__index">02 <span aria-hidden="true">/</span> 04</p>
    </div>
    <h1 class="display page-head__title"><%= content.about.title %></h1>
    <div class="page-head__foot">
      <p class="page-head__lead"><%= content.about.lead %></p>
      <div class="page-head__meta">
        <p><span>Based in</span><%= site.location %></p>
        <p><span>Working since</span>2016</p>
      </div>
    </div>
  </header>

  <section class="section about-story" aria-labelledby="story-title">
    <div class="shell about-story__grid">
      <figure class="about-story__figure">
        <%- picture(content.about.portrait, {
          class: 'about-story__img',
          sizes: '(min-width: 900px) 40vw, 100vw'
        }) %>
        <figcaption class="figure-caption">
          <span>Portrait</span>
          <span><%= site.location %></span>
        </figcaption>
      </figure>

      <div class="about-story__text">
        <p class="eyebrow">Biography</p>
        <h2 class="visually-hidden" id="story-title">Biography</h2>
        <% content.about.bio.forEach(function (para, i) { %>
          <p class="about-story__para<%= i === 0 ? ' about-story__para--lead' : '' %>"><%= para %></p>
        <% }); %>

        <div class="about-story__services">
          <p class="eyebrow">Selected services</p>
          <ul>
            <% content.about.highlights.services.forEach(function (service) { %>
              <li><%= service %></li>
            <% }); %>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section approach" aria-labelledby="approach-title">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Approach</p>
        <p class="section-head__index">03 <span aria-hidden="true">/</span> 04</p>
      </div>
      <h2 class="display approach__title" id="approach-title">How the work is made</h2>

      <div class="approach__grid">
        <% content.about.approach.forEach(function (item, i) { %>
          <article class="approach__item">
            <span class="approach__num"><%= String(i + 1).padStart(2, '0') %></span>
            <h3 class="approach__name"><%= item.title %></h3>
            <p class="approach__text"><%= item.body %></p>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section experience" aria-labelledby="experience-title">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Experience</p>
        <p class="section-head__index">04 <span aria-hidden="true">/</span> 04</p>
      </div>
      <h2 class="display experience__title" id="experience-title">A working life</h2>

      <ol class="experience__list">
        <% content.about.experience.forEach(function (item) { %>
          <li class="experience__row">
            <span class="experience__years"><%= item.years %></span>
            <span class="experience__role"><%= item.role %></span>
            <span class="experience__place"><%= item.place %></span>
          </li>
        <% }); %>
      </ol>
    </div>
  </section>

  <section class="section highlights" aria-labelledby="highlights-title">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Selected clients &amp; recognition</p>
      </div>
      <h2 class="visually-hidden" id="highlights-title">Clients and recognition</h2>

      <div class="highlights__grid">
        <div class="highlights__col">
          <h3 class="highlights__label">Clients</h3>
          <ul>
            <% content.about.highlights.clients.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        </div>
        <div class="highlights__col">
          <h3 class="highlights__label">Publications</h3>
          <ul>
            <% content.about.highlights.publications.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        </div>
        <div class="highlights__col">
          <h3 class="highlights__label">Awards</h3>
          <ul>
            <% content.about.highlights.awards.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        </div>
        <div class="highlights__col highlights__col--note">
          <h3 class="highlights__label">Studio</h3>
          <p><%= site.availability %></p>
          <a class="link-arrow" href="/contact"><span>Get in touch</span><%- include('partials/icon', { name: 'arrow' }) %></a>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/cta') %>
</main>

<%- include('partials/footer') %>
