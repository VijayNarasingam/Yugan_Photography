<footer class="site-footer">
  <div class="site-footer__invite">
    <p class="eyebrow">Currently</p>
    <p class="site-footer__availability"><%= site.availability %></p>
    <a class="site-footer__email" href="mailto:<%= site.email %>"><%= site.email %></a>
  </div>

  <div class="site-footer__grid">
    <div class="site-footer__brand">
      <a class="brand brand--footer" href="/" aria-label="<%= site.name %> — home">
        <span class="brand__name"><%= site.name %></span>
        <span class="brand__role">Photography</span>
      </a>
      <p class="site-footer__note"><%= site.footerNote %></p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/work">Work</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>

    <div class="site-footer__socials">
      <p class="eyebrow">Elsewhere</p>
      <% (site.socials || []).forEach(function (social) { %>
        <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer">
          <%= social.label %>
          <% if (social.handle) { %><span><%= social.handle %></span><% } %>
          <%- include('icon', { name: 'arrowUpRight' }) %>
        </a>
      <% }); %>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>© <%= year %> <%= site.name %>. All photographs are the property of the artist.</p>
    <p class="site-footer__location"><%- include('icon', { name: 'pin' }) %> <%= site.location %></p>
    <button class="theme-toggle theme-toggle--footer" type="button" data-theme-toggle aria-label="Switch to dark theme">
      <span class="theme-toggle__sun" aria-hidden="true"><%- include('icon', { name: 'sun' }) %></span>
      <span class="theme-toggle__moon" aria-hidden="true"><%- include('icon', { name: 'moon' }) %></span>
      <span data-theme-label>Dark</span>
    </button>
  </div>
</footer>
<script src="/js/site.js" defer></script>
</body>
</html>
