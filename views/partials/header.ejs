<header class="site-header<%= headerOverlay ? ' site-header--overlay' : '' %>" data-header>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="<%= site.name %> — home">
      <span class="brand__name"><%= site.name %></span>
      <span class="brand__role">Photography</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href="/work" class="site-nav__link<%= navSection === 'work' ? ' is-current' : '' %>"<%= navSection === 'work' ? ' aria-current="page"' : '' %>>
        <span class="site-nav__index">01</span>Work
      </a>
      <a href="/about" class="site-nav__link<%= navSection === 'about' ? ' is-current' : '' %>"<%= navSection === 'about' ? ' aria-current="page"' : '' %>>
        <span class="site-nav__index">02</span>About
      </a>
      <a href="/contact" class="site-nav__link<%= navSection === 'contact' ? ' is-current' : '' %>"<%= navSection === 'contact' ? ' aria-current="page"' : '' %>>
        <span class="site-nav__index">03</span>Contact
      </a>
    </nav>

    <div class="site-header__tools">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme">
        <span class="theme-toggle__sun" aria-hidden="true"><%- include('icon', { name: 'sun' }) %></span>
        <span class="theme-toggle__moon" aria-hidden="true"><%- include('icon', { name: 'moon' }) %></span>
      </button>
      <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="mobile-menu">
        <span class="nav-toggle__label">Menu</span>
        <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <div class="mobile-menu__inner">
    <nav class="mobile-menu__nav" aria-label="Mobile">
      <a href="/work"><span>01</span>Work</a>
      <a href="/about"><span>02</span>About</a>
      <a href="/contact"><span>03</span>Contact</a>
    </nav>
    <div class="mobile-menu__foot">
      <p class="eyebrow"><%= site.availability %></p>
      <a class="mobile-menu__email" href="mailto:<%= site.email %>"><%= site.email %></a>
      <div class="mobile-menu__socials">
        <% (site.socials || []).forEach(function (social) { %>
          <a href="<%= social.url %>" rel="noopener noreferrer" target="_blank"><%= social.label %></a>
        <% }); %>
      </div>
    </div>
  </div>
</div>
