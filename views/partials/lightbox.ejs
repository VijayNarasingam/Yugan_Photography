<div class="lightbox" data-lightbox hidden>
  <div class="lightbox__backdrop" data-lightbox-close></div>
  <div class="lightbox__dialog" role="dialog" aria-modal="true" aria-label="Photograph viewer" data-lightbox-dialog>
    <div class="lightbox__top">
      <p class="lightbox__counter" data-lightbox-counter>1 / 1</p>
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close viewer">
        <%- include('icon', { name: 'close' }) %>
      </button>
    </div>
    <div class="lightbox__stage">
      <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous photograph">
        <%- include('icon', { name: 'chevronLeft' }) %>
      </button>
      <figure class="lightbox__figure">
        <img class="lightbox__image" data-lightbox-image alt="">
        <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
      </figure>
      <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next photograph">
        <%- include('icon', { name: 'chevronRight' }) %>
      </button>
    </div>
  </div>
</div>
