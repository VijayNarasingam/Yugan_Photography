<article class="project-card project-card--<%= variant || 'default' %>" data-category="<%= project.category %>">
  <a class="project-card__link" href="/work/<%= project.slug %>">
    <figure class="project-card__figure">
      <%- picture(project.cover, {
        class: 'project-card__img',
        sizes: sizes || '(min-width: 1100px) 50vw, 100vw',
        width: 960
      }) %>
      <span class="project-card__view" aria-hidden="true"><%- include('icon', { name: 'arrowUpRight' }) %></span>
    </figure>
    <div class="project-card__meta">
      <span class="project-card__index"><%= index %></span>
      <div class="project-card__titles">
        <h3 class="project-card__title"><%= project.title %></h3>
        <p class="project-card__sub"><%= project.category %> <span aria-hidden="true">·</span> <%= project.year %></p>
      </div>
      <span class="project-card__arrow" aria-hidden="true"><%- include('icon', { name: 'arrow' }) %></span>
    </div>
    <p class="project-card__summary"><%= project.summary %></p>
  </a>
</article>
