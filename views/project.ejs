<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <div class="shell project-top">
    <a class="back-link" href="/work"><%- include('partials/icon', { name: 'arrowLeft' }) %> All work</a>
    <p class="project-top__count"><%= String(project.order).padStart(2, '0') %> <span aria-hidden="true">/</span> <%= String(content.projects.filter(function (p) { return p.visible; }).length).padStart(2, '0') %></p>
  </div>

  <header class="project-head shell">
    <div class="project-head__title-row">
      <h1 class="display project-head__title"><%= project.title %></h1>
      <p class="project-head__summary"><%= project.summary %></p>
    </div>
    <div class="project-head__meta">
      <p><span>Discipline</span><%= project.category %></p>
      <p><span>Year</span><%= project.year %></p>
      <p><span>Location</span><%= project.location %></p>
      <p><span>Photographs</span><%= photos.length %></p>
    </div>
  </header>

  <figure class="project-cover">
    <%- picture(project.cover, {
      priority: true,
      class: 'project-cover__img',
      sizes: '100vw',
      width: 1600
    }) %>
  </figure>

  <section class="section project-story" aria-labelledby="story-title">
    <div class="shell project-story__grid">
      <div class="project-story__text">
        <p class="eyebrow">The series</p>
        <h2 class="visually-hidden" id="story-title">About this series</h2>
        <% paragraphs(project.description).forEach(function (para) { %>
          <p><%= para %></p>
        <% }); %>
      </div>
      <aside class="project-story__aside">
        <p class="eyebrow">Details</p>
        <dl>
          <div><dt>Commission</dt><dd><%= project.category %></dd></div>
          <div><dt>Year</dt><dd><%= project.year %></dd></div>
          <div><dt>Location</dt><dd><%= project.location %></dd></div>
          <div><dt>Photographs</dt><dd><%= photos.length %></dd></div>
        </dl>
        <a class="link-arrow" href="/contact"><span>Enquire about prints</span><%- include('partials/icon', { name: 'arrow' }) %></a>
      </aside>
    </div>
  </section>

  <% if (photos.length) { %>
  <section class="section project-gallery" aria-labelledby="gallery-title">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">The photographs</p>
        <p class="section-head__index"><%= String(photos.length).padStart(2, '0') %> frames</p>
      </div>
      <h2 class="visually-hidden" id="gallery-title">Photographs from <%= project.title %></h2>

      <div class="gallery" data-gallery>
        <% photos.forEach(function (photo, i) { %>
          <% var m = findMedia(photo.mediaId); %>
          <% var full = m ? mediaFullUrl(m) : ''; %>
          <figure class="gallery-item gallery-item--<%= i % 4 %>">
            <button class="gallery-item__button" type="button"
              data-lightbox-item
              data-full="<%= full %>"
              data-caption="<%= photo.caption %>"
              data-alt="<%= photo.alt %>"
              aria-label="View photograph <%= i + 1 %> of <%= photos.length %><%= photo.caption ? ': ' + photo.caption : '' %>">
              <%- picture(photo, {
                class: 'gallery-item__img',
                sizes: '(min-width: 900px) 52vw, 100vw'
              }) %>
              <span class="gallery-item__expand" aria-hidden="true"><%- include('partials/icon', { name: 'expand' }) %></span>
            </button>
            <figcaption class="gallery-item__caption">
              <span class="gallery-item__num"><%= String(i + 1).padStart(2, '0') %></span>
              <span><%= photo.caption || photo.alt %></span>
            </figcaption>
          </figure>
        <% }); %>
      </div>
    </div>
  </section>
  <% } else { %>
  <section class="section project-gallery">
    <div class="shell empty-state empty-state--inline">
      <p class="eyebrow">Gallery</p>
      <h2 class="display">Photographs coming soon.</h2>
      <p>This series is being prepared. Please check back, or get in touch for a preview.</p>
    </div>
  </section>
  <% } %>

  <% if (nextProject) { %>
  <section class="next-project" aria-labelledby="next-title">
    <div class="shell next-project__inner">
      <div class="next-project__text">
        <p class="eyebrow">Next project</p>
        <h2 class="display next-project__title" id="next-title"><%= nextProject.title %></h2>
        <p class="next-project__summary"><%= nextProject.summary %></p>
        <a class="link-arrow" href="/work/<%= nextProject.slug %>"><span>View project</span><%- include('partials/icon', { name: 'arrow' }) %></a>
      </div>
      <a class="next-project__media" href="/work/<%= nextProject.slug %>" aria-label="View next project: <%= nextProject.title %>">
        <%- picture(nextProject.cover, {
          class: 'next-project__img',
          sizes: '(min-width: 900px) 44vw, 100vw'
        }) %>
      </a>
    </div>
  </section>
  <% } %>
</main>

<%- include('partials/lightbox') %>
<%- include('partials/footer') %>
