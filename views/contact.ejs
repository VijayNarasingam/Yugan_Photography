<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <header class="page-head page-head--contact shell">
    <div class="page-head__top">
      <p class="eyebrow"><%= content.contact.kicker %></p>
      <p class="page-head__index">03 <span aria-hidden="true">/</span> 04</p>
    </div>
    <h1 class="display page-head__title"><%= content.contact.title %></h1>
    <p class="page-head__lead page-head__lead--wide"><%= content.contact.invitation %></p>
  </header>

  <section class="section contact" aria-labelledby="contact-form-title">
    <div class="shell contact__grid">
      <div class="contact__form-wrap">
        <div class="contact__form-head">
          <h2 class="eyebrow" id="contact-form-title">Project enquiry</h2>
          <p class="contact__reply">Replies within two working days</p>
        </div>

        <form class="contact-form" id="contact-form" data-contact-form novalidate>
          <div class="field-row">
            <div class="field">
              <label class="field__label" for="contact-name">Your name <span aria-hidden="true">*</span></label>
              <input class="field__input" type="text" id="contact-name" name="name" autocomplete="name" required minlength="2" maxlength="80" aria-describedby="error-name">
              <p class="field__error" id="error-name" data-error-for="name" hidden></p>
            </div>
            <div class="field">
              <label class="field__label" for="contact-email">Email <span aria-hidden="true">*</span></label>
              <input class="field__input" type="email" id="contact-email" name="email" autocomplete="email" required maxlength="160" aria-describedby="error-email">
              <p class="field__error" id="error-email" data-error-for="email" hidden></p>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="contact-type">What is this about?</label>
            <div class="select-wrap">
              <select class="field__input field__select" id="contact-type" name="projectType" aria-describedby="error-projectType">
                <option value="">Choose a project type</option>
                <% content.contact.projectTypes.forEach(function (type) { %>
                  <option value="<%= type %>"><%= type %></option>
                <% }); %>
              </select>
              <span class="select-wrap__icon" aria-hidden="true"><%- include('partials/icon', { name: 'arrowDown' }) %></span>
            </div>
            <p class="field__error" id="error-projectType" data-error-for="projectType" hidden></p>
          </div>

          <div class="field">
            <label class="field__label" for="contact-message">A little about the project <span aria-hidden="true">*</span></label>
            <textarea class="field__input field__textarea" id="contact-message" name="message" rows="6" required minlength="10" maxlength="2000" aria-describedby="error-message hint-message"></textarea>
            <p class="field__hint" id="hint-message">Timing, place, and the shape of what you have in mind. Ten characters minimum.</p>
            <p class="field__error" id="error-message" data-error-for="message" hidden></p>
          </div>

          <div class="field field--honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off">
          </div>

          <div class="contact-form__foot">
            <button class="button button--ink" type="submit" data-submit>
              <span data-submit-label>Send enquiry</span>
              <span class="button__spinner" data-submit-spinner aria-hidden="true"></span>
              <%- include('partials/icon', { name: 'arrowUpRight' }) %>
            </button>
            <p class="contact-form__note"><%= content.contact.formNote %></p>
          </div>

          <div class="form-status" data-form-status role="status" aria-live="polite" hidden></div>
        </form>

        <div class="contact-success" data-contact-success hidden>
          <span class="contact-success__icon" aria-hidden="true"><%- include('partials/icon', { name: 'check' }) %></span>
          <p class="eyebrow">Sent</p>
          <h2 class="display contact-success__title">Thank you — your note is with me.</h2>
          <p data-contact-success-text>I will reply within two working days.</p>
          <button class="button button--outline" type="button" data-contact-reset>Send another note</button>
        </div>
      </div>

      <aside class="contact__aside">
        <figure class="contact__figure">
          <%- picture(content.contact.image, {
            class: 'contact__img',
            sizes: '(min-width: 900px) 40vw, 100vw'
          }) %>
          <figcaption class="figure-caption">
            <span>Studio</span>
            <span><%= site.location %></span>
          </figcaption>
        </figure>

        <div class="contact__details">
          <div class="contact__detail">
            <p class="eyebrow">Email</p>
            <a href="mailto:<%= site.email %>"><%= site.email %></a>
          </div>
          <% if (site.phone) { %>
          <div class="contact__detail">
            <p class="eyebrow">Telephone</p>
            <a href="tel:<%= site.phone.replace(/[^\d+]/g, '') %>"><%= site.phone %></a>
          </div>
          <% } %>
          <div class="contact__detail">
            <p class="eyebrow">Studio</p>
            <p><%= site.location %></p>
          </div>
          <div class="contact__detail">
            <p class="eyebrow">Elsewhere</p>
            <div class="contact__socials">
              <% (site.socials || []).forEach(function (social) { %>
                <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer"><%= social.label %> <%- include('partials/icon', { name: 'arrowUpRight' }) %></a>
              <% }); %>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
